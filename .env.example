# Токен бота от @BotFather (без него сайт работает, но без бота и уведомлений)
BOT_TOKEN=
# Юзернейм бота без @ — для кнопки на сайте
BOT_USERNAME=
# Telegram ID администраторов через запятую (узнать свой — у @userinfobot)
ADMIN_IDS=
# Контакт администратора для раздела «Помощь», например @username
ADMIN_CONTACT=
# Пароль входа в админку сайта — поменяйте на длинный
ADMIN_PASSWORD=change-me
# Секрет для подписи сессий админки — длинная случайная строка (openssl rand -hex 32)
SECRET_KEY=change-me-too
# Локально — SQLite; в Docker Compose подменяется на PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./poizon.db
# Хранилище состояний бота; пусто — в памяти. В Docker Compose подставляется Redis
REDIS_URL=
# Локальная разработка: запускать бота внутри uvicorn одним процессом
BOT_IN_API=false
